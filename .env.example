# ============================================================
# HACHI WordPress Theme — 環境変数テンプレート
# ============================================================
# このファイルはコミット対象（実際の値は含まない）
# 実際の値は wp-config.php または サーバー環境変数に設定すること
#
# セットアップ手順:
#   wp-config.php で define() するか、サーバー環境変数に設定する
#   WordPress 定数名は各項目のコメントを参照
# ============================================================

# ------------------------------------------------------------
# Google Tag Manager / GA4
# WordPress 定数名: HACHI_GTM_CONTAINER_ID / HACHI_GA4_MEASUREMENT_ID
# ------------------------------------------------------------
GTM_CONTAINER_ID=[GTM-XXXXXXX]
GA4_MEASUREMENT_ID=[G-XXXXXXXXXX]

# ------------------------------------------------------------
# WordPress セキュリティキー（8種類）
# https://api.wordpress.org/secret-key/1.1/salt/ で生成
# WordPress 定数名: AUTH_KEY, SECURE_AUTH_KEY, LOGGED_IN_KEY,
#                  NONCE_KEY, AUTH_SALT, SECURE_AUTH_SALT,
#                  LOGGED_IN_SALT, NONCE_SALT
# 【重要】本番デプロイ前に必ず生成した値で置き換えること
# ------------------------------------------------------------
WP_AUTH_KEY=[生成した値]
WP_SECURE_AUTH_KEY=[生成した値]
WP_LOGGED_IN_KEY=[生成した値]
WP_NONCE_KEY=[生成した値]
WP_AUTH_SALT=[生成した値]
WP_SECURE_AUTH_SALT=[生成した値]
WP_LOGGED_IN_SALT=[生成した値]
WP_NONCE_SALT=[生成した値]

# ------------------------------------------------------------
# reCAPTCHA v3
# https://www.google.com/recaptcha/admin
# ------------------------------------------------------------
RECAPTCHA_SITE_KEY=[reCAPTCHA サイトキー]
RECAPTCHA_SECRET_KEY=[reCAPTCHA シークレットキー]

# ------------------------------------------------------------
# Slack（デプロイ通知・アラート）
# https://api.slack.com/apps > Incoming Webhooks
# ------------------------------------------------------------
SLACK_WEBHOOK_URL=[Slack Incoming Webhook URL]

# ------------------------------------------------------------
# メール送信（お問い合わせフォーム）
# WordPress SMTP プラグインまたは wp-config.php で設定
# ------------------------------------------------------------
SMTP_HOST=[SMTPサーバーホスト]
SMTP_PORT=587
SMTP_USER=[SMTPユーザー名]
SMTP_PASS=[SMTPパスワード]
CONTACT_FORM_TO=[受信メールアドレス]

# ------------------------------------------------------------
# GitHub Actions 専用シークレット（リポジトリ Settings > Secrets で設定）
# ------------------------------------------------------------
# SFTP_HOST           - デプロイ先サーバーホスト
# SFTP_USER           - デプロイ用 SSH ユーザー
# SFTP_PRIVATE_KEY    - SSH 秘密鍵
