# ============================================================
# HACHI WordPress — .htaccess セキュリティ設定
# Apache 2.4+ / mod_rewrite 必須
# WordPress の標準 .htaccess に追記してください
# ============================================================

# ── WordPress 標準リライトルール ──────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

# ── 1. HTTPS 強制リダイレクト ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(.+)$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── 2. セキュリティヘッダー (Apache レベル) ───────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # HSTS (本番のみ有効化 — テスト環境ではコメントアウト)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # サーバー情報を隠す
    Header unset X-Powered-By
    Header unset Server

    # キャッシュポリシー (機密ページはキャッシュしない)
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── 3. ServerSignature / ServerTokens ────────────────────────
ServerSignature Off
# ServerTokens Prod  ← httpd.conf に記述すること

# ── 4. ディレクトリインデックスの無効化 ─────────────────────
Options -Indexes

# ── 5. 危険なファイルへの直接アクセスをブロック ─────────────
<FilesMatch "^(wp-config\.php|xmlrpc\.php|readme\.html|readme\.txt|license\.txt|wp-cron\.php|install\.php|upgrade\.php|\.env|\.env\.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── 6. wp-config.php へのアクセスを完全ブロック (Deny from all) ──────────────
<Files "wp-config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# ── 7. .htaccess / .htpasswd へのアクセスをブロック ───────────
<FilesMatch "^\.ht">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── 8. PHP ファイルをアップロードディレクトリで実行禁止 ────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^wp-content/uploads/.*\.php$ - [F,L]
    RewriteRule ^wp-content/uploads/.*\.phtml$ - [F,L]
    RewriteRule ^wp-content/uploads/.*\.phar$ - [F,L]
</IfModule>

# ── 9. xmlrpc.php を完全ブロック ────────────────────────────
<Files "xmlrpc.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# ── 10. wp-login.php へのアクセスを IP 制限 ──────────────────
# ⚠ 実際のオフィスIPに変更してください
<Files "wp-login.php">
    <IfModule mod_authz_core.c>
        Require ip 203.0.113.0/24    # 例: オフィスIPレンジ
        Require ip 127.0.0.1         # ローカル開発
        # Require ip YOUR_OFFICE_IP
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
        Allow from 203.0.113.0/24
        Allow from 127.0.0.1
    </IfModule>
</Files>

# ── 11. wp-admin/ へのアクセスを IP 制限 ────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/wp-admin/
    RewriteCond %{REMOTE_ADDR} !^203\.0\.113\. [NC]  # オフィスIPに変更
    RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$
    RewriteRule ^ - [F,L]
</IfModule>

# ── 12. 危険なリクエストメソッドをブロック ─────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DELETE|PATCH|PUT|OPTIONS) [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# ── 13. SQLインジェクション・XSS をブロック (WAF補助) ─────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # SQLインジェクション試行
    RewriteCond %{QUERY_STRING} (union.*select|select.*from|insert.*into|drop.*table) [NC,OR]
    RewriteCond %{QUERY_STRING} (benchmark|sleep\()                                   [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./\.\.)                                            [NC,OR]
    RewriteCond %{QUERY_STRING} (<script|</script|javascript:)                        [NC,OR]
    RewriteCond %{QUERY_STRING} (base64_encode|eval\()                                [NC]
    RewriteRule ^ - [F,L]

    # ユーザー名列挙の防止
    RewriteCond %{QUERY_STRING} ^author=\d
    RewriteRule ^ /? [R=301,L]
</IfModule>

# ── 14. 不審な User-Agent をブロック ───────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nessus|acunetix|havij|w3af|libwww|zgrab|masscan|python-requests|scrapy) [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# ── 15. Hotlinking 防止 ───────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?hachi\.co\.jp/ [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,NC]
</IfModule>

# ── 16. ファイルタイプ別キャッシュ設定 (パフォーマンス) ─────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 6 months"
    ExpiresByType text/css                "access plus 6 months"
    ExpiresByType application/javascript  "access plus 6 months"
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresDefault                        "access plus 1 month"
</IfModule>

# ── 17. Gzip 圧縮 (パフォーマンス) ──────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE font/woff2 image/svg+xml
</IfModule>
